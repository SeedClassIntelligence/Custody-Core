# DATABASE_URL: PostgreSQL connection string (Supabase or Neon)
DATABASE_URL="postgres://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"

# Supabase Project API URL
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# The PUBLIC (anon) key: Supabase dashboard > Project Settings > API > Project API keys > anon / public.
# Safe for the browser. Never put the service_role key anywhere in this app: it is not used.
SUPABASE_ANON_KEY="[YOUR-ANON-PUBLIC-KEY]"
VITE_SUPABASE_ANON_KEY="[YOUR-ANON-PUBLIC-KEY]"

# MFA_ENCRYPTION_KEY: SERVER ONLY. Encrypts the authenticator-app keys stored in the database.
# Generate once with:  openssl rand -base64 32
# Never give it a VITE_ prefix. If it is lost, everyone has to set up their authenticator again.
MFA_ENCRYPTION_KEY="[32-RANDOM-BYTES-BASE64]"

# APP_URL: where this app is reached, without a trailing slash (GitHub sends creators back here).
APP_URL="https://custody.example.com"

# Code home: the GitHub App. SERVER ONLY, never with a VITE_ prefix. Steps: docs/GITHUB_APP_SETUP.md
GITHUB_APP_ID="[APP-ID-NUMBER]"
GITHUB_APP_SLUG="[APP-URL-NAME]"
GITHUB_APP_CLIENT_ID="[CLIENT-ID]"
GITHUB_APP_CLIENT_SECRET="[CLIENT-SECRET]"
GITHUB_WEBHOOK_SECRET="[openssl rand -hex 32]"
GITHUB_APP_PRIVATE_KEY="[THE .pem FILE, line breaks written as \n]"

# End-to-end test only (docs/GITHUB_APP_SETUP.md): a dedicated TEST organization, never your real one.
# GITHUB_E2E_ORG="[test-org]"
# GITHUB_E2E_INSTALLATION_ID="[number]"
# GITHUB_E2E_OWNER="[GitHub username of an owner of the test organization]"
# GITHUB_REAL_ORG="[your-real-org]"
