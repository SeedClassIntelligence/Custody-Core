# DATABASE_URL: PostgreSQL connection string (Supabase or Neon)
DATABASE_URL="postgres://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"

# APP_DB_PASSWORD: SERVER ONLY. The password of custody_app, the restricted database account the app runs as.
# Generate once with:  openssl rand -base64 24   (at least 16 characters; there is no default)
# The server sets custody_app to this password every time it starts, so changing it here rotates it.
APP_DB_PASSWORD="[RANDOM-PASSWORD]"

# DATABASE_SSL_CA (optional, recommended): Supabase's certificate, from Project Settings > Database >
# SSL configuration > Download certificate. Either the file's path or its contents. With it the server checks
# the database's certificate; without it the connection is encrypted but the certificate is not checked.
# DATABASE_SSL_CA="/path/to/prod-ca-2021.crt"

# Supabase Project API URL
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# The PUBLIC (anon) key: Supabase dashboard > Project Settings > API > Project API keys > anon / public.
# Safe for the browser. Never put the service_role key anywhere in this app: it is not used.
SUPABASE_ANON_KEY="[YOUR-ANON-PUBLIC-KEY]"
VITE_SUPABASE_ANON_KEY="[YOUR-ANON-PUBLIC-KEY]"

# MFA_ENCRYPTION_KEY: SERVER ONLY. Encrypts the authenticator-app keys stored in the database.
# Generate once with:  openssl rand -base64 32
# Never give it a VITE_ prefix. If it is lost, everyone has to set up their authenticator again.
MFA_ENCRYPTION_KEY="[32-RANDOM-BYTES-BASE64]"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
